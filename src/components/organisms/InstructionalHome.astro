---
import Button from '@/components/atoms/Button.astro';
import Icon from '@/components/atoms/Icon.astro';
---

<div class="min-h-dvh px-4 py-8 max-w-lg mx-auto">
  <div class="text-center mb-10">
    <img
      src="/ourlens-logo.png"
      alt="Ourlens"
      width="64"
      height="64"
      class="mx-auto mb-4 rounded-full"
    />
    <h1 class="text-3xl font-bold text-on-surface mb-2">
      How to scan your home
    </h1>
    <p class="text-lg text-on-surface-muted">
      Follow these steps to get an AI-powered safety assessment.
    </p>
  </div>

  <ol class="space-y-8" role="list">
    <li class="flex gap-4 animate-stagger-fade" style="--stagger-index: 0;">
      <span
        class="min-h-tap min-w-tap flex items-center justify-center bg-gradient-to-br from-brand-500 to-accent-400 text-white font-bold text-lg rounded-accessible shrink-0"
        aria-hidden="true"
      >
        1
      </span>
      <div>
        <h2 class="text-xl font-semibold text-on-surface mb-2">
          Find good lighting
        </h2>
        <p class="text-base text-on-surface-muted">
          Turn on room lights and open curtains. The AI needs clear visibility
          to spot hazards accurately.
        </p>
      </div>
    </li>

    <li class="flex gap-4 animate-stagger-fade" style="--stagger-index: 1;">
      <span
        class="min-h-tap min-w-tap flex items-center justify-center bg-gradient-to-br from-brand-500 to-accent-400 text-white font-bold text-lg rounded-accessible shrink-0"
        aria-hidden="true"
      >
        2
      </span>
      <div>
        <h2 class="text-xl font-semibold text-on-surface mb-2">
          Hold your phone steadily
        </h2>
        <p class="text-base text-on-surface-muted">
          Use both hands and hold the phone at eye level. Move slowly from
          room to room.
        </p>
      </div>
    </li>

    <li class="flex gap-4 animate-stagger-fade" style="--stagger-index: 2;">
      <span
        class="min-h-tap min-w-tap flex items-center justify-center bg-gradient-to-br from-brand-500 to-accent-400 text-white font-bold text-lg rounded-accessible shrink-0"
        aria-hidden="true"
      >
        3
      </span>
      <div>
        <h2 class="text-xl font-semibold text-on-surface mb-2">
          Cover every corner
        </h2>
        <p class="text-base text-on-surface-muted">
          Scan floors, stairs, bathrooms, and hallways. Pay extra attention to
          rugs, cords, and tight spaces.
        </p>
      </div>
    </li>

    <li class="flex gap-4 animate-stagger-fade" style="--stagger-index: 3;">
      <span
        class="min-h-tap min-w-tap flex items-center justify-center bg-gradient-to-br from-brand-500 to-accent-400 text-white font-bold text-lg rounded-accessible shrink-0"
        aria-hidden="true"
      >
        4
      </span>
      <div>
        <h2 class="text-xl font-semibold text-on-surface mb-2">
          Tap &ldquo;Start Scan&rdquo; when ready
        </h2>
        <p class="text-base text-on-surface-muted">
          The camera will capture frames for 10 seconds. You&rsquo;ll see a
          progress indicator while the AI analyzes your home.
        </p>
      </div>
    </li>
  </ol>

  <div class="mt-8 rounded-accessible border border-on-surface-muted/20 bg-surface-alt p-4">
    <p class="text-base text-on-surface-muted leading-relaxed">
      <strong class="text-on-surface">Before you start:</strong> do not include
      other people or personal documents in the frame. Images are sent for AI
      analysis. Read the{' '}
      <a href="/privacy" class="font-semibold text-on-surface underline">
        privacy notice
      </a>
      .
    </p>
  </div>

  <div class="mt-12 text-center">
    <Button href="/scanner" variant="primary" size="lg">
      <Icon name="camera" size="lg" class="mr-2" />
      Start Scan
    </Button>
  </div>
</div>